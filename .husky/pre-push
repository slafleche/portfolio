#!/bin/sh

set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
YARN_CJS="$REPO_ROOT/.yarn/releases/yarn-4.11.0.cjs"

node_major() {
  "$1" -p "process.versions.node.split('.')[0]" 2>/dev/null || echo ""
}

pick_node20() {
  for candidate in \
    "/opt/homebrew/opt/node@20/bin/node" \
    "/usr/local/opt/node@20/bin/node"
  do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done

  candidate="$(command -v node 2>/dev/null || true)"
  if [ -n "$candidate" ] && [ "$(node_major "$candidate")" = "20" ]; then
    echo "$candidate"
    return 0
  fi

  return 1
}

NODE20="$(pick_node20)" || {
  echo "pre-push: Node 20 is required for this repo (.nvmrc/engines)."
  echo "Install with: brew install node@20"
  exit 1
}

if [ ! -f "$YARN_CJS" ]; then
  echo "pre-push: expected Yarn at $YARN_CJS"
  exit 1
fi

has_main_push=0
has_staging_push=0
has_release_push=0

# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) has_main_push=1 ;;
    refs/heads/staging) has_staging_push=1 ;;
    refs/heads/release) has_release_push=1 ;;
    *) ;;
  esac

  if [ "$remote_ref" = "refs/heads/main" ]; then
    # If the remote SHA isn't an ancestor of the local SHA, this is a non-fast-forward
    # update (i.e. requires --force / --force-with-lease). Treat that as an explicit
    # bypass request and skip the local CI check.
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
      if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
          echo "↪︎ pre-push: non-fast-forward update to main detected; skipping 'yarn ci' (force push bypass)."
          exit 0
        fi
      fi
    fi
  fi
done

if [ "$has_main_push" -eq 1 ] || [ "$has_staging_push" -eq 1 ] || [ "$has_release_push" -eq 1 ]; then
  echo "→ pre-push: running 'yarn ci' (push to protected branch)"
  "$NODE20" "$YARN_CJS" ci
fi
