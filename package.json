{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "chroma-js": "^3.1.2",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "hls.js": "^1.6.13",
    "marked": "^12.0.2",
    "next": "^15.5.5",
    "normalize.css": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@svgr/webpack": "^8.1.0",
    "@types/chroma-js": "^3.1.1",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/esbuild-plugin": "^2.3.18",
    "@vanilla-extract/next-plugin": "^2.4.14",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "autoprefixer": "^10.4.21",
    "chokidar": "^4.0.3",
    "csstype": "^3.1.3",
    "esbuild": "^0.25.11",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "execa": "^9.6.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "marked": "^15.0.11",
    "open-cli": "^8.0.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-jsdoc": "^1.3.3",
    "prettier-plugin-multiline-arrays": "^4.0.3",
    "prettier-plugin-xml": "^0.1.0",
    "pretty-bytes": "^7.1.0",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "undici": "^7.16.0",
    "wait-on": "^9.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "yarn@4.9.4",
  "scripts": {
    "fresh": "yarn install && yarn setup",
    "setup": "yarn copy:html && yarn fonts && yarn format:visual",
    "copy:html": "tsx scripts/generateCopyHtml.ts",
    "fonts:chars": "tsx scripts/generateFontTexts.ts",
    "fonts:urls": "tsx scripts/generateFontUrls.ts",
    "fonts": "yarn fonts:chars && yarn fonts:urls",
    "dev": "DEBUG_VE=1 next dev",
    "prebuild": "yarn copy:html && MINIFY=1 yarn fonts",
    "build": "next build",
    "start": "next start",
    "lint:locales": "tsx scripts/checkLocaleMarkdown.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:code": "prettier --write .",
    "format:svg": "prettier --no-config --parser html \"src/assets/**/*.{svg,SVG}\" --write",
    "format:img": "node scripts/generateImages.mjs",
    "format:video": "node scripts/generateVideos.mjs",
    "format:visual": "yarn format:video && yarn format:img",
    "format:assets": "MINIFY=1 yarn fonts && yarn format:visual",
    "svg:clean": "yarn svgo && yarn format:svg",
    "svgo": "node scripts/optimizeSvgs.mjs --write",
    "upgrade:latest": "yarn up \"*@latest\" \"@*/*@latest\" && yarn dedupe"
  }
}
