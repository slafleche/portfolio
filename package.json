    "wait-on": "^7.0.1"
  },
  "scripts": {
    "locales": "node scripts/generateLocales.mjs",
    "predev": "yarn locales",
    "prebuild": "MINIFY=1 yarn locales",
    "dev": "next dev",
    "build": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:open": "yarn dev & wait-on http://localhost:3000 && open-cli http://localhost:3000",
    "format:svg": "prettier --no-config --parser html \"src/assets/**/*.{svg,SVG}\" --write",
    "svg:clean": "yarn svgo && yarn format:svg",
    "svgo": "node scripts/optimize-svgs.mjs --write",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "packageManager": "yarn@4.9.4"
