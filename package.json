{
	"name": "portfolio",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"dependencies": {
		"chroma-js": "^3.1.2",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"hls.js": "^1.6.13",
		"next": "^15.5.2",
		"normalize-css": "^2.3.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.8.2",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@svgr/webpack": "^8.1.0",
		"@types/chroma-js": "^3.1.1",
		"@types/culori": "^4",
		"@types/react": "^18.2.7",
		"@types/react-dom": "^18.2.4",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"@vanilla-extract/css": "^1.17.4",
		"@vanilla-extract/esbuild-plugin": "^2.3.18",
		"@vanilla-extract/next-plugin": "^2.4.14",
		"@vanilla-extract/recipes": "^0.5.7",
		"@vanilla-extract/sprinkles": "^1.6.5",
		"autoprefixer": "^10.4.21",
		"chokidar": "^3.5.1",
		"esbuild": "^0.25.9",
		"eslint": "^9.35.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-config-standard": "^17.1.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-promise": "^6.1.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"execa": "^9.6.0",
		"ffmpeg-static": "^5.2.0",
		"ffprobe-static": "^3.1.0",
		"open-cli": "^8.0.0",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"prettier": "^3.6.2",
		"prettier-plugin-jsdoc": "^1.3.3",
		"prettier-plugin-multiline-arrays": "^4.0.3",
		"prettier-plugin-xml": "^0.1.0",
		"pretty-bytes": "^7.1.0",
		"sharp": "^0.34.3",
		"strip-json-comments": "^3.1.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.42.0",
		"undici": "^7.16.0",
		"wait-on": "^7.0.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"scripts": {
		"locales": "node scripts/generateLocales.mjs",
		"fonts:chars": "node scripts/generateFontTexts.mjs",
		"fonts:urls": "tsx scripts/generateFontUrls.ts",
		"fonts": "yarn locales && yarn fonts:chars && yarn fonts:urls",
		"dev:open": "yarn dev & wait-on http://localhost:3000/en && open-cli http://localhost:3000/en",
		"predev": "yarn locales && yarn format:video && yarn format:img",
		"dev": "next dev",
		"prebuild": "MINIFY=1 yarn locales && yarn format:video && yarn format:img",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format:code": "prettier --write .",
		"format:svg": "prettier --no-config --parser html \"src/assets/**/*.{svg,SVG}\" --write",
		"format:img": "node scripts/generateImages.mjs",
		"format:video": "node scripts/generateVideos.mjs",
		"format:visual": "yarn format:video && yarn format:img",
		"svg:clean": "yarn svgo && yarn format:svg && yarn format:img",
		"svgo": "node scripts/optimizeSvgs.mjs --write"
	},
	"packageManager": "yarn@4.9.4"
}
