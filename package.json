{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@lafleche/gooey-react": "^1.2.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "css-calipers": "^0.7.0",
    "culori": "^4.0.2",
    "hls.js": "^1.6.15",
    "marked": "^17.0.1",
    "next": "^16.0.7",
    "normalize.css": "^8.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chroma-js": "^3.1.2",
    "@types/culori": "^4.0.1",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.17.5",
    "@vanilla-extract/esbuild-plugin": "^2.3.20",
    "@vanilla-extract/next-plugin": "^2.4.16",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "@vanilla-extract/vite-plugin": "^5.1.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "chokidar": "^5.0.0",
    "csstype": "^3.2.3",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "marked": "^17.0.1",
    "open-cli": "^8.0.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-jsdoc": "^1.7.0",
    "prettier-plugin-multiline-arrays": "^4.0.5",
    "prettier-plugin-xml": "^0.1.0",
    "pretty-bytes": "^7.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "undici": "^7.16.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix",
      "node scripts/checkLintRules.mjs --plain"
    ]
  },
  "packageManager": "yarn@4.11.0",
  "engines": {
    "node": "20.19.6"
  },
  "scripts": {
    "ci:candidate": "yarn setup:noVideo && yarn lint && yarn typecheck && yarn test",
    "ci:local": "CI=true yarn ci:candidate",
    "ci:publish": "yarn setup && yarn lint && yarn typecheck && yarn test && yarn build",
    "fresh": "yarn install && yarn setup",
    "setup": "yarn locales:markdown& yarn format:assets && yarn locales:publish",
    "setup:noVideo": "yarn locales:markdown && yarn format:assets:noVideo && yarn format:video:mock && yarn locales:publish",
    "locales": "yarn locales:markdown && yarn locales:publish",
    "locales:markdown": "tsx scripts/generateLocaleMarkdown.ts",
    "locales:publish": "tsx scripts/generateCopyHtml.ts",
    "fonts:chars": "tsx scripts/generateFontTexts.ts",
    "fonts:urls": "tsx scripts/generateFontUrls.ts",
    "fonts": "yarn fonts:chars && yarn fonts:urls",
    "font:smoketest": "VERIFY_FONT_URLS=true yarn fonts:urls",
    "dev": "DEBUG_VE=1 node scripts/devWithDebug.mjs --webpack",
    "build": "next build --webpack",
    "clean:next": "rm -rf .next",
    "clean:caches": "rm -f tsconfig.tsbuildinfo",
    "clean:assets": "rm -rf public/images public/favicons public/videos src/data/generated src/lib/locales/generated tmp",
    "clean:assets:keepVideo": "rm -rf public/images public/favicons src/data/generated/images.manifest.gen.json src/data/generated/favicons.manifest.gen.ts src/lib/locales/generated tmp",
    "clean": "yarn clean:next && yarn clean:caches && yarn clean:assets",
    "start": "next start",
    "typecheck": "yarn tsc --noEmit",
    "lint": "yarn lint:base && yarn lint:rules && yarn lint:secrets && yarn lint:locales",
    "lint:locales": "yarn locales:markdown && tsx scripts/checkLocaleMarkdown.ts",
    "lint:base": "eslint .",
    "lint:secrets": "SECRET_LOOKOUT_ALL=1 node scripts/checkSecretLookout.mjs",
    "lint:secrets:staged": "node scripts/checkSecretLookout.mjs",
    "lint:rules": "LINT_RULES_ALL=1 node scripts/checkLintRules.mjs --human",
    "lint:fix": "eslint --fix .",
    "format:assets": "MINIFY=1 yarn fonts && yarn format:visual && yarn favicons",
    "format:assets:noVideo": "MINIFY=1 yarn fonts && yarn format:img && yarn favicons",
    "format:code": "prettier --write .",
    "format:svg": "prettier --no-config --parser html \"src/assets/**/*.{svg,SVG}\" --write",
    "format:img": "node scripts/generateImages.mjs",
    "format:video": "node scripts/generateVideos.mjs",
    "format:video:mock": "tsx scripts/generateMockVideos.ts",
    "format:visual": "yarn format:video && yarn format:img",
    "svg:clean": "yarn svgo && yarn format:svg",
    "svgo": "node scripts/optimizeSvgs.mjs --write",
    "favicons": "node --import tsx scripts/generateFavicons.ts",
    "test": "vitest run",
    "test:form": "vitest run tests/contact",
    "test:api": "vitest run tests/api tests/server",
    "test:brevo": "vitest run tests/server/deliverContactMessage.test.ts tests/api/contact.route.test.ts tests/api/contact.health.route.test.ts",
    "test:watch": "vitest --watch",
    "scenarios": "tsx scripts/devScenarios.ts",
    "scenarios:reset": "tsx scripts/devScenarios.ts --reset",
    "scenarios:all": "tsx scripts/devScenarios.ts --all --open-all",
    "upgrade:latest": "yarn up \"*@latest\" \"@*/*@latest\" && yarn dedupe"
  }
}
