{
  "name": "@portfolio/cdn-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.19.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.715.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "cdn:delete": "tsx cdnClient.mts delete",
    "cdn:delete:version": "tsx cdnClient.mts delete-version",
    "cdn:delete:prefix": "tsx cdnClient.mts delete-prefix",
    "cdn:ls": "tsx cdnClient.mts ls",
    "cdn:sync": "tsx cdnSyncManifests.mts",

    "fonts": "yarn generate:selfHosted && yarn generate:googleFonts",
    "generate:selfHosted": "tsx ../scripts/generateLocalFonts.mts",
    "generate:googleFonts": "tsx ../scripts/generateFontUrls.mts",
    
  
    "generate:fonts": "yarn fonts",
    "generate:img": "node ../scripts/generateImages.mjs",
    "generate:video": "node ../scripts/generateVideos.mjs",
    "generate:video:posters": "node ../scripts/generateVideos.mjs --posters-only"
  }
}
