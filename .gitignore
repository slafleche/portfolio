# -----------------------
# Node / Dependencies
# -----------------------
node_modules/
.pnp.*
.pnp.js

# -----------------------
# Yarn Berry (v2+)
# Commit .yarn except caches/build-state.
# If you use Zero-Installs, you may commit .yarn/cache as well.
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# -----------------------
# Build artifacts
# -----------------------
.next/
out/
build/
dist/

# -----------------------
# Testing / Coverage
# -----------------------
coverage/

# -----------------------
# Lockfiles
# -----------------------
package-lock.json

# -----------------------
# Bash scripts
# -----------------------
scripts/bash/

# -----------------------
# Generated data
# -----------------------
src/data/generated/*
public/images/*
public/favicons/*
src/lib/locales/generated/


# -----------------------
# Local env files
# -----------------------
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.prod

# -----------------------
# Vercel
# -----------------------
.vercel/

# -----------------------
# TypeScript
# -----------------------
*.tsbuildinfo

# -----------------------
# VSCode local settings (keep shared settings)
# -----------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# -----------------------
# Misc
# -----------------------
.DS_Store
*.pem
TODO.*.md

# -----------------------
# Local tools / scripts (ignored by default)
# -----------------------
.local/*
!.local/.gitkeep

# -----------------------
# Debug logs
# -----------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# -----------------------
# Large Images
# -----------------------
src/assets/images/imageBackup/*
src/assets/videos/videoBackup/*
public/videos/*
tmp/*
