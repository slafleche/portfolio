{
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "always",
  "quoteProps": "as-needed",
  "arrayBracketNewline": "always",
  "arrayElementNewline": "always",
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "printWidth": 1
      }
    }
  ]
}
